# Server configuration, copy to .env and fill in real values.
NODE_ENV=development
PORT=4000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/ar_riyadh_academy

# CORS origins allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:5173

# The account created by `npm run seed`. Change the password before deploying.
SEED_ADMIN_EMAIL=admin@arriyaadh.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Academy Admin

# Paystack. Leave blank to run the API without live payments; the payment
# endpoints then refuse to initialise a transaction and the webhook refuses
# every request.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_API_BASE=https://api.paystack.co
