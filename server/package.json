{
  "name": "ar-riyadh-academy-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node data/seed.js",
    "test": "node --test --test-force-exit --test-concurrency=1 --test-timeout=60000 test/*.test.mjs",
    "test:api": "node --test --test-force-exit --test-timeout=60000 test/api.test.mjs",
    "test:dashboard": "node --test --test-force-exit --test-timeout=60000 test/dashboard.test.mjs",
    "test:routes": "node --test --test-force-exit --test-timeout=60000 test/routes.test.mjs",
    "test:seed": "node --test --test-force-exit --test-timeout=60000 test/seed.test.mjs",
    "validate": "python3 ../scripts/validate_models.py",
    "smoke": "node ../scripts/smoke.mjs",
    "dev:mongo": "node scripts/dev-mongo.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "mongoose": "^8.7.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
